generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String
  published      Boolean   @default(false)
  featured       Boolean   @default(false)
  coverImage     String?
  tags           String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]  @default([])
  seoImage       String?

  @@map("posts")
}

model Project {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  description    String
  content        String?
  published      Boolean       @default(false)
  featured       Boolean       @default(false)
  coverImage     String?
  images         String[]
  technologies   String[]
  liveUrl        String?
  githubUrl      String?
  category       String?
  status         ProjectStatus @default(COMPLETED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]      @default([])
  seoImage       String?

  @@map("projects")
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String?
  features    String[]
  price       String?
  popular     Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

model Contact {
  id        String         @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    ContactStatus  @default(UNREAD)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  reason    ContactReason?

  @@map("contacts")
}

model Article {
  id             String            @id @default(cuid())
  title          String
  slug           String            @unique
  excerpt        String?
  content        String
  published      Boolean           @default(false)
  featured       Boolean           @default(false)
  coverImage     String?
  tags           String[]
  category       String?
  difficulty     ArticleDifficulty @default(BEGINNER)
  readTime       Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  seoKeywords    String[]          @default([])
  seoImage       String?

  @@map("articles")
}

model Design {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String
  content     String?
  published   Boolean        @default(false)
  featured    Boolean        @default(false)
  coverImage  String?
  images      String[]
  tags        String[]
  category    DesignCategory @default(WEB_DESIGN)
  tools       String[]
  clientName  String?
  projectUrl  String?
  figmaUrl    String?
  behanceUrl  String?
  dribbbleUrl String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("designs")
}

model Resource {
  id            String       @id @default(cuid())
  title         String
  description   String?
  type          ResourceType
  url           String
  category      String?
  image         String?
  isAffiliate   Boolean      @default(false)
  displayOrder  Int          @default(0)
  published     Boolean      @default(true)
  clickCount    Int          @default(0)
  tags          String[]     @default([])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  gumroadUrl    String?
  price         String?
  audioDuration String?
  audioUrl      String?
  narrator      String?
  author        String?
  linkType      String?
  rating        Float?

  @@index([type, displayOrder])
  @@index([published])
  @@index([rating])
  @@map("resources")
}

model Analytics {
  id     String   @id @default(cuid())
  page   String
  visits Int      @default(1)
  date   DateTime @default(now())

  @@unique([page, date])
  @@map("analytics")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ContactStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

enum ContactReason {
  PROJECT
  WORK
  CONSULTING
  READING_LIST
  TECH_ESSENTIALS
  WALLPAPERS
  PODCAST
  COLLABORATION
  OTHER
}

enum ArticleDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum DesignCategory {
  WEB_DESIGN
  WEB_APP
  MOBILE_APP
  UI_UX
  BRANDING
  ILLUSTRATION
  DESIGN_SYSTEM
}

enum ResourceType {
  READING_LIST
  TECH_ESSENTIALS
  WALLPAPERS
  TALENT
  INVESTMENT
  NEWSLETTER
  PODCAST
  AUDIOBOOK
  BOOKS
  USEFUL_LINKS
}

// =====================
// JOB RADAR (job-search automation)
// =====================

model TargetCompany {
  id          String     @id @default(cuid())
  name        String     @unique // human-readable, e.g. "Anthropic"
  slug        String     // ATS board slug, e.g. "anthropic"
  source      JobSource  // which ATS to use
  tier        CompanyTier
  careersUrl  String?
  notes       String?
  active      Boolean    @default(true)
  lastFetched DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  jobs        Job[]

  @@unique([slug, source])
  @@map("target_companies")
}

model Job {
  id              String        @id @default(cuid())
  externalId      String        // the ATS's own id — used for dedup
  source          JobSource
  title           String
  company         String
  companyId       String?
  companyRef      TargetCompany? @relation(fields: [companyId], references: [id])
  location        String?
  remote          Boolean       @default(false)
  description     String        // truncated to ~4000 chars for storage
  url             String
  salary          String?
  tags            String[]      @default([])
  postedAt        DateTime?
  fetchedAt       DateTime      @default(now())
  score           Int           @default(0)   // 0–100
  scoreReasons    String[]      @default([])
  visaFriendly    Boolean?      // null = unknown
  remoteFromEgypt Boolean?      // null = unknown
  status          JobStatus     @default(NEW)
  action          JobAction?

  @@unique([externalId, source])
  @@index([status, score])
  @@index([fetchedAt])
  @@map("jobs")
}

model JobAction {
  id        String          @id @default(cuid())
  jobId     String          @unique
  job       Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind      JobActionKind
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("job_actions")
}

enum JobSource {
  GREENHOUSE
  ASHBY
  LEVER
  REMOTEOK
  WUZZUF
  BAYT
  LINKEDIN_POSTS
  OTHER
}

enum CompanyTier {
  EGYPT_MENA      // tier 1 — local/regional
  GLOBAL_AI       // tier 2 — AI/FDE sweet spot
  GLOBAL_SENIOR   // tier 3 — senior remote-friendly
  GLOBAL_ENTERPRISE // tier 4 — big-name occasional remote
}

enum JobStatus {
  NEW
  SURFACED
  APPLIED
  DISMISSED
  ARCHIVED
}

enum JobActionKind {
  APPLIED
  DISMISSED
  SAVED
  DRAFTED_COVER
}
