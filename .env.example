# Database
DATABASE_URL="postgresql://username:password@localhost:5432/portfolio"

# Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxx"

# Next Auth
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Resend Email Service
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"

# Strapi CMS (Optional - if using Strapi)
NEXT_PUBLIC_STRAPI_URL="http://localhost:1337"
STRAPI_API_TOKEN="your-strapi-api-token-here"

# Email Configuration
SENDER_EMAIL="contact@yourdomain.com"
RECIPIENT_EMAIL="your-email@yourdomain.com"

# Google OAuth (for Admin Dashboard)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# Admin Configuration
ADMIN_EMAILS="your-admin-email@example.com"
ADMIN_EMAIL="your-admin-email@example.com"

# Vercel BotID (for Contact Form spam protection)
# Note: BotID is automatically enabled when deployed to Vercel
# No additional environment variables needed
# Enable "BotID Deep Analysis" in Vercel Dashboard > Project > Firewall > Configure
